<Window x:Class="CrashAnalyzer.UI.KeyDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="API 키 등록" Width="470" SizeToContent="Height" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" FontSize="13" Background="{StaticResource Card}"
        FontFamily="Segoe UI Variable Text, Segoe UI, Malgun Gothic">
    <StackPanel Margin="16">
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,10"
                   Text="Anthropic Console 에서 만든 자기 API 키를 넣어 주세요. 키는 이 PC 의 이 Windows 계정으로만 풀 수 있게 암호화해 보관하고, 화면이나 기록에 남기지 않습니다. AI 에 물을 때마다 이 키의 계정에 요금이 청구됩니다."/>
        <TextBlock Text="API 키" FontWeight="SemiBold"/>
        <PasswordBox x:Name="pwKey" Margin="0,4,0,4"/>
        <TextBlock x:Name="txtErr" Foreground="{StaticResource Red}" FontSize="12" Margin="0,0,0,10" TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="등록" Style="{StaticResource BtnPrimary}" Width="92" Margin="0,0,8,0" IsDefault="True" Click="OnOk"/>
            <Button Content="취소" Style="{StaticResource BtnSecondary}" Width="80" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>CrashAnalyzer.UI</RootNamespace>
    <AssemblyName>CrashAnalyzerUI</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <!-- 2026-11-16: AI 설명(사용자 자기 API 키) — 묶음·호출·권고 검사는 이 라이브러리에 있다 -->
    <ProjectReference Include="..\CrashAnalyzer.Ai\CrashAnalyzer.Ai.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- 상담 도우미 그림 (2026-11-02). 이 파일만 같은 이름으로 바꿔 넣으면 버튼·창 그림이 바뀐다. -->
    <None Update="assets\chatbot.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>

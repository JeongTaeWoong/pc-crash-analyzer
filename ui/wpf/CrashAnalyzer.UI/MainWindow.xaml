<Window x:Class="CrashAnalyzer.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PC Crash Analyzer" Width="1240" Height="820" MinWidth="1080" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Surface}"
        FontFamily="Segoe UI Variable Text, Segoe UI, Malgun Gothic" FontSize="13"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">

    <DockPanel>
        <!-- ─── 머리글 ─── -->
        <Border DockPanel.Dock="Top" Background="{StaticResource Ink}" Padding="18,0" Height="58">
            <DockPanel VerticalAlignment="Center" LastChildFill="True">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="PC Crash Analyzer" Foreground="White" FontSize="17" FontWeight="Bold"
                               VerticalAlignment="Center"/>
                    <Rectangle Width="1" Height="20" Fill="#3B4D6E" Margin="16,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="txtHeaderSnap" Text="스냅샷 없음 — 수집기를 켜거나 덤프를 여세요"
                               Foreground="#9FB0C9" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="txtElevation" Foreground="#D9A741" VerticalAlignment="Center" Margin="0,0,14,0" FontSize="12"/>
                    <Button Content="최근 덤프 열기" Style="{StaticResource BtnGhost}" Margin="0,0,8,0" Click="OnOpenLatestDump"/>
                    <Button Content="스냅샷 열기…" Style="{StaticResource BtnPrimary}" Click="OnOpenSnapshotFile"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ─── 상태 줄 ─── -->
        <Border DockPanel.Dock="Bottom" Background="#E9EDF3" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="18,6">
            <TextBlock x:Name="txtStatus" Text="준비됨" Foreground="{StaticResource TextDim}" FontSize="12"/>
        </Border>

        <!-- ─── 본문: 콘텐츠 + 수집기 레일 ─── -->
        <Grid Margin="18,14,18,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="292"/>
            </Grid.ColumnDefinitions>

            <TabControl x:Name="tabs" Grid.Column="0" Margin="0,0,16,0">

                <!-- ① 진단 결과 -->
                <TabItem Header="진단 결과">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="4,14,8,8">
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="7*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="5*"/>
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource CardBox}" Grid.Column="0">
                                    <StackPanel>
                                        <TextBlock Text="어느 층의 문제인가 (층 판정)" Style="{StaticResource SectionTitle}"/>
                                        <ItemsControl x:Name="icLayerBars">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="110"/>
                                                            <ColumnDefinition Width="188"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextStrong}"/>
                                                        <Border Grid.Column="1" Background="{StaticResource LineSoft}" Height="12"
                                                                CornerRadius="6" VerticalAlignment="Center" HorizontalAlignment="Left" Width="180">
                                                            <Border Background="{Binding Fill}" Width="{Binding FillWidth}" Height="12"
                                                                    CornerRadius="6" HorizontalAlignment="Left"/>
                                                        </Border>
                                                        <TextBlock Grid.Column="2" Text="{Binding PctText}" Margin="10,0,0,0"
                                                                   Foreground="{StaticResource TextDim}" FontWeight="SemiBold"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock x:Name="txtConfLine" Style="{StaticResource Faint}" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource CardBox}" Grid.Column="2">
                                    <StackPanel>
                                        <TextBlock Text="요약" Style="{StaticResource SectionTitle}"/>
                                        <TextBlock x:Name="txtSummary" Style="{StaticResource Dim}" Text="스냅샷을 열면 진단 요약이 표시됩니다."/>
                                        <TextBlock x:Name="txtMetaLine" Style="{StaticResource Faint}" Margin="0,10,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="7*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="5*"/>
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource CardBox}" Grid.Column="0">
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock Text="원인 후보 순위" Style="{StaticResource SectionTitle}" DockPanel.Dock="Left"/>
                                            <Button x:Name="btnStartSession" Content="원인 확인 시작 →" Style="{StaticResource BtnPrimary}"
                                                    HorizontalAlignment="Right" IsEnabled="False" Click="OnStartSession" Margin="0,-4,0,6"/>
                                        </DockPanel>
                                        <ListBox x:Name="lbCandidates" MaxHeight="268" SelectionChanged="OnCandidateSelected"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Opacity="{Binding RowOpacity}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="30"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="52"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Width="22" Height="22" CornerRadius="11" Background="{Binding RankBg}"
                                                                VerticalAlignment="Center" HorizontalAlignment="Left">
                                                            <TextBlock Text="{Binding Rank}" Foreground="{Binding RankFg}" FontSize="11"
                                                                       FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Label}" Foreground="{StaticResource TextStrong}" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding SubText}" Style="{StaticResource Faint}"/>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="2" Text="{Binding ProbText}" FontWeight="SemiBold" FontSize="14"
                                                                   Foreground="{StaticResource TextStrong}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource CardBox}" Grid.Column="2">
                                    <StackPanel>
                                        <TextBlock Text="근거 (왜 이 후보인가)" Style="{StaticResource SectionTitle}"/>
                                        <TextBlock x:Name="txtSelCand" FontWeight="SemiBold" Foreground="{StaticResource TextStrong}"
                                                   Text="왼쪽에서 후보를 선택하세요" Margin="0,0,0,6" TextWrapping="Wrap"/>
                                        <ItemsControl x:Name="icSelEvidence">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Text}" Style="{StaticResource Dim}" Margin="0,2"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Border Style="{StaticResource CardBox}">
                                <StackPanel>
                                    <TextBlock x:Name="txtPlanSummary" Text="엔진이 정한 원인 확인 순서" Style="{StaticResource SectionTitle}"/>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="34"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="76"/>
                                            <ColumnDefinition Width="86"/>
                                            <ColumnDefinition Width="92"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="1" Text="점검 → 대상" Style="{StaticResource Faint}"/>
                                        <TextBlock Grid.Column="2" Text="예상 시간" Style="{StaticResource Faint}"/>
                                        <TextBlock Grid.Column="3" Text="드러날 확률" Style="{StaticResource Faint}"/>
                                        <TextBlock Grid.Column="4" Text="실행 방식" Style="{StaticResource Faint}"/>
                                    </Grid>
                                    <ItemsControl x:Name="icSteps">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{StaticResource LineSoft}" BorderThickness="0,1,0,0" Padding="0,9">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="34"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="76"/>
                                                            <ColumnDefinition Width="86"/>
                                                            <ColumnDefinition Width="92"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Index}" Foreground="{StaticResource TextFaint}"
                                                                   FontWeight="SemiBold" VerticalAlignment="Top" Margin="4,1,0,0"/>
                                                        <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                                            <TextBlock Text="{Binding Title}" Foreground="{StaticResource TextStrong}"
                                                                       FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                            <TextBlock Text="{Binding Advice}" Style="{StaticResource Faint}" Margin="0,2,0,0"/>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="2" Text="{Binding CostText}" Foreground="{StaticResource TextDim}" VerticalAlignment="Top"/>
                                                        <TextBlock Grid.Column="3" Text="{Binding ChanceText}" Foreground="{StaticResource TextDim}" VerticalAlignment="Top"/>
                                                        <Border Grid.Column="4" Background="{Binding ExecBg}" CornerRadius="10"
                                                                Padding="9,3" HorizontalAlignment="Left" VerticalAlignment="Top">
                                                            <TextBlock Text="{Binding ExecText}" Foreground="{Binding ExecFg}" FontSize="11" FontWeight="SemiBold"/>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <ItemsControl x:Name="icNotes" Margin="0,8,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" Style="{StaticResource Faint}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ② 원인 확인 -->
                <TabItem Header="원인 확인">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid Margin="4,14,8,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="7*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="5*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <Border Style="{StaticResource CardBox}" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock x:Name="txtSessionStatus" Style="{StaticResource SectionTitle}"
                                                   Text="세션 없음 — 진단 탭에서 [원인 확인 시작]을 누르세요"/>
                                        <TextBlock x:Name="txtNextAction" Style="{StaticResource Dim}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource CardBox}" x:Name="cardNextCheck" Visibility="Collapsed">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,6">
                                            <TextBlock Text="지금 할 점검" Style="{StaticResource SectionTitle}" Margin="0" DockPanel.Dock="Left"/>
                                            <Border x:Name="bdCheckExec" Background="{StaticResource LineSoft}" CornerRadius="10"
                                                    Padding="9,3" HorizontalAlignment="Right">
                                                <TextBlock x:Name="txtCheckExec" Text="안내" Foreground="{StaticResource TextDim}"
                                                           FontSize="11" FontWeight="SemiBold"/>
                                            </Border>
                                        </DockPanel>
                                        <TextBlock x:Name="txtCheckLabel" FontSize="15" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextStrong}" TextWrapping="Wrap"/>
                                        <TextBlock x:Name="txtCheckChance" Style="{StaticResource Faint}" Margin="0,2,0,6"/>
                                        <TextBlock x:Name="txtCheckAdvice" Style="{StaticResource Dim}"/>
                                        <ItemsControl x:Name="icCheckSteps" Margin="0,8,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{StaticResource TextStrong}"
                                                               Margin="0,2" LineHeight="19"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock x:Name="txtCheckRollback" Style="{StaticResource Faint}" Margin="0,8,0,0"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                            <Button Content="원인이 드러났어요" Style="{StaticResource BtnGood}" Margin="0,0,8,0" Click="OnReportSolved"/>
                                            <Button Content="아니었어요" Style="{StaticResource BtnSecondary}" Margin="0,0,8,0" Click="OnReportNotSolved"/>
                                            <Button Content="건너뛰기" Style="{StaticResource BtnSecondary}" Click="OnReportSkipped"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <Border Style="{StaticResource CardBox}" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="후보 확률 (점검 결과에 따라 갱신)" Style="{StaticResource SectionTitle}"/>
                                        <ItemsControl x:Name="icBelief">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="0,4" Opacity="{Binding RowOpacity}">
                                                        <TextBlock Text="{Binding Text}" Foreground="{StaticResource TextStrong}" TextWrapping="Wrap"/>
                                                        <Border Background="{StaticResource LineSoft}" Height="8" CornerRadius="4"
                                                                HorizontalAlignment="Left" Width="164" Margin="0,3,0,0">
                                                            <Border Background="{Binding Fill}" Width="{Binding FillWidth}" Height="8"
                                                                    CornerRadius="4" HorizontalAlignment="Left"/>
                                                        </Border>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource CardBox}">
                                    <StackPanel>
                                        <TextBlock Text="지난 점검" Style="{StaticResource SectionTitle}"/>
                                        <ItemsControl x:Name="icHistory">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" Style="{StaticResource Faint}" Margin="0,2"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </TabItem>

                <!-- ③ 해결 · 검증 -->
                <TabItem Header="해결 · 검증">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid Margin="4,14,8,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="7*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="5*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <Border Style="{StaticResource CardBox}" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="확인된 원인" Style="{StaticResource SectionTitle}"/>
                                        <TextBlock x:Name="txtConfirmed" FontWeight="SemiBold" FontSize="15"
                                                   Foreground="{StaticResource TextStrong}" Text="아직 없음" TextWrapping="Wrap"/>
                                        <ItemsControl x:Name="icConfirmedEvidence" Margin="0,6,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Text}" Style="{StaticResource Dim}" Margin="0,2"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource CardBox}">
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock Text="해결책 (기대 해결률 순)" Style="{StaticResource SectionTitle}" DockPanel.Dock="Left"/>
                                            <Button x:Name="btnApplyFix" Content="적용했어요 (기록)" Style="{StaticResource BtnPrimary}"
                                                    HorizontalAlignment="Right" IsEnabled="False" Click="OnApplyFix" Margin="0,-4,0,6"/>
                                        </DockPanel>
                                        <ListBox x:Name="lbRemedies" SelectionChanged="OnRemedySelected" MaxHeight="180">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Title}" FontWeight="{Binding TitleWeight}"
                                                                   Foreground="{StaticResource TextStrong}"/>
                                                        <TextBlock Text="{Binding SubText}" Style="{StaticResource Faint}"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <Border BorderBrush="{StaticResource LineSoft}" BorderThickness="0,1,0,0" Margin="0,8,0,0" Padding="0,8,0,0">
                                            <ItemsControl x:Name="icRemedyActions">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding}" Style="{StaticResource Dim}" Margin="0,2"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <Border Style="{StaticResource CardBox}">
                                    <StackPanel>
                                        <TextBlock Text="재발 검증" Style="{StaticResource SectionTitle}"/>
                                        <TextBlock Style="{StaticResource Dim}"
                                                   Text="해결책 적용 후 충분히 사용해 본 다음, 둘 중 한 방법으로 검증합니다."/>
                                        <Button Content="사후 스냅샷으로 검증…" Style="{StaticResource BtnSecondary}"
                                                HorizontalAlignment="Left" Margin="0,10,0,0" Click="OnVerifyAfterSnapshot"/>
                                        <Border BorderBrush="{StaticResource LineSoft}" BorderThickness="0,1,0,0" Margin="0,12,0,10"/>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="관찰 시간(분)" Foreground="{StaticResource TextDim}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBox x:Name="txtObservedMinutes" Width="56" Text="120"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <Button Content="재발 없었어요" Style="{StaticResource BtnGood}" Margin="0,0,8,0" Click="OnVerifyNoRecur"/>
                                            <Button Content="재발했어요" Style="{StaticResource BtnSecondary}" Click="OnVerifyRecurred"/>
                                        </StackPanel>
                                        <TextBlock x:Name="txtLastVerify" Foreground="{StaticResource TextStrong}" FontWeight="SemiBold" Margin="0,12,0,0"/>
                                        <TextBlock x:Name="txtRestoreNote" Style="{StaticResource Faint}" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </TabItem>

                <!-- ④ 수집기 로그 -->
                <TabItem Header="수집기 로그">
                    <Border Style="{StaticResource CardBox}" Margin="4,14,8,8" Padding="2">
                        <TextBox x:Name="txtLog" IsReadOnly="True" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                 TextWrapping="NoWrap" BorderThickness="0" Background="#101521" Foreground="#C9D4E8" Padding="10"/>
                    </Border>
                </TabItem>
            </TabControl>

            <!-- ─── 수집기 레일 ─── -->
            <StackPanel Grid.Column="1">
                <Border Style="{StaticResource CardBox}" Margin="0,6,0,12">
                    <StackPanel>
                        <TextBlock Text="블랙박스 수집기" Style="{StaticResource SectionTitle}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Ellipse x:Name="dotCollector" Width="9" Height="9" Fill="#B9C2CF" VerticalAlignment="Center"/>
                            <TextBlock x:Name="txtCollectorState" Text="꺼짐" Margin="7,0,0,0"
                                       Foreground="{StaticResource TextDim}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="btnCollectorStart" Content="수집 시작" Style="{StaticResource BtnPrimary}"
                                    Margin="0,0,8,0" Click="OnCollectorStart"/>
                            <Button x:Name="btnCollectorStop" Content="중지" Style="{StaticResource BtnSecondary}"
                                    IsEnabled="False" Click="OnCollectorStop"/>
                        </StackPanel>
                        <CheckBox x:Name="chkAutoDiagnose" Content="새 덤프가 생기면 자동 진단" IsChecked="True"
                                  Margin="0,12,0,0" Foreground="{StaticResource TextDim}"/>
                        <TextBlock Style="{StaticResource Faint}" Margin="0,8,0,0"
                                   Text="켜 두면 최근 5분을 메모리에만 기록하다가, 크래시가 감지되는 순간 전후 구간을 덤프합니다."/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBox}">
                    <StackPanel>
                        <TextBlock Text="최근 활동" Style="{StaticResource SectionTitle}"/>
                        <ItemsControl x:Name="icActivity">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Style="{StaticResource Faint}" Margin="0,2" TextWrapping="Wrap"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="txtNoActivity" Style="{StaticResource Faint}" Text="아직 활동이 없습니다."/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>

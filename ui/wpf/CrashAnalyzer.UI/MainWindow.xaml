<Window x:Class="CrashAnalyzer.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PC Crash Analyzer" Width="1060" Height="760" WindowStartupLocation="CenterScreen"
        Background="#F4F6F9" FontSize="13">
    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D9DEE7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="H1" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Foreground" Value="#1F2A3D"/>
        </Style>
        <Style x:Key="Dim" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#5B6678"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- 머리글: 수집기 제어 + 덤프 열기 -->
        <Border DockPanel.Dock="Top" Background="#1F2A3D" Padding="12,10">
            <DockPanel LastChildFill="True">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <TextBlock Text="PC Crash Analyzer" Foreground="White" FontSize="16" FontWeight="Bold"
                               VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <TextBlock x:Name="txtCollectorState" Text="수집기: 꺼짐" Foreground="#FFB4B9C6"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Button x:Name="btnCollectorStart" Content="수집기 시작" Click="OnCollectorStart"/>
                    <Button x:Name="btnCollectorStop" Content="중지" Click="OnCollectorStop" IsEnabled="False"/>
                    <CheckBox x:Name="chkAutoDiagnose" Content="새 덤프 자동 진단" Foreground="White"
                              VerticalAlignment="Center" IsChecked="True" Margin="6,0,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock x:Name="txtElevation" Text="" Foreground="#FFD9A741" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Button Content="최근 덤프 열기" Click="OnOpenLatestDump"/>
                    <Button Content="스냅샷 열기..." Click="OnOpenSnapshotFile"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 상태 줄 -->
        <Border DockPanel.Dock="Bottom" Background="#E8ECF3" Padding="10,5">
            <TextBlock x:Name="txtStatus" Text="준비됨" Foreground="#3A4659"/>
        </Border>

        <TabControl x:Name="tabs" Margin="10">
            <!-- ① 진단 결과 -->
            <TabItem Header="① 진단 결과">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4">
                    <StackPanel x:Name="pnlDiagnose" Margin="4">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock x:Name="txtSnapInfo" Style="{StaticResource H1}" Text="스냅샷을 열어 주세요"/>
                                <TextBlock x:Name="txtSymptomLine" Style="{StaticResource Dim}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock x:Name="txtLayerLine" Style="{StaticResource H1}" Text="층 판정"/>
                                <ItemsControl x:Name="icLayerBars">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                                <TextBlock Text="{Binding Name}" Width="70"/>
                                                <Border Background="#3B5BA5" Height="12" Width="{Binding BarWidth}"
                                                        CornerRadius="3" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding PctText}" Margin="8,0,0,0" Foreground="#5B6678"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <ItemsControl x:Name="icLayerEvidence" Margin="0,6,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Text}" Style="{StaticResource Dim}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock Text="원인 후보" Style="{StaticResource H1}" DockPanel.Dock="Left"/>
                                    <Button x:Name="btnStartSession" Content="세션 시작 (원인 확인 →)" HorizontalAlignment="Right"
                                            Click="OnStartSession" IsEnabled="False"/>
                                </DockPanel>
                                <ItemsControl x:Name="icCandidates">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Expander Header="{Binding Header}" Margin="0,2">
                                                <ItemsControl ItemsSource="{Binding Evidence}" Margin="18,4,0,4">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Text}" Style="{StaticResource Dim}"/>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Expander>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock x:Name="txtPlanSummary" Style="{StaticResource H1}" Text="원인 확인 순서"/>
                                <ItemsControl x:Name="icSteps">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#E3E8F0" BorderThickness="0,0,0,1" Padding="0,6">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Header}" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding Meta}" Style="{StaticResource Dim}"/>
                                                    <TextBlock Text="{Binding Advice}" Style="{StaticResource Dim}" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <ItemsControl x:Name="icNotes" Margin="0,8,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" Style="{StaticResource Dim}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ② 원인 확인 (세션) -->
            <TabItem Header="② 원인 확인">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4">
                    <StackPanel Margin="4">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock x:Name="txtSessionStatus" Style="{StaticResource H1}" Text="세션 없음 — ① 탭에서 [세션 시작]"/>
                                <TextBlock x:Name="txtNextAction" Style="{StaticResource Dim}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="후보 확률" Style="{StaticResource H1}"/>
                                <ItemsControl x:Name="icBelief">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                                <Border Background="#3B5BA5" Height="10" Width="{Binding BarWidth}"
                                                        CornerRadius="3" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBlock Text="{Binding Text}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" x:Name="cardNextCheck" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="지금 할 점검" Style="{StaticResource H1}"/>
                                <TextBlock x:Name="txtCheckLabel" FontWeight="SemiBold" FontSize="14"/>
                                <TextBlock x:Name="txtCheckMeta" Style="{StaticResource Dim}"/>
                                <TextBlock x:Name="txtCheckAdvice" Style="{StaticResource Dim}" Margin="0,4,0,0"/>
                                <ItemsControl x:Name="icCheckSteps" Margin="0,4,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="txtCheckRollback" Style="{StaticResource Dim}" Margin="0,4,0,0"/>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button Content="원인이 드러났어요 (solved)" Click="OnReportSolved" Background="#DBF0DD"/>
                                    <Button Content="아니었어요 (not_solved)" Click="OnReportNotSolved"/>
                                    <Button Content="건너뛰기" Click="OnReportSkipped"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="지난 점검" Style="{StaticResource H1}"/>
                                <ItemsControl x:Name="icHistory">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" Style="{StaticResource Dim}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ③ 해결 · 검증 -->
            <TabItem Header="③ 해결 · 검증">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4">
                    <StackPanel Margin="4">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="확인된 원인" Style="{StaticResource H1}"/>
                                <TextBlock x:Name="txtConfirmed" FontWeight="SemiBold" Text="아직 없음"/>
                                <ItemsControl x:Name="icConfirmedEvidence" Margin="0,4,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Text}" Style="{StaticResource Dim}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock Text="해결책 (기대 해결률 순)" Style="{StaticResource H1}" DockPanel.Dock="Left"/>
                                    <Button x:Name="btnApplyFix" Content="적용했어요 (기록)" HorizontalAlignment="Right"
                                            Click="OnApplyFix" IsEnabled="False"/>
                                </DockPanel>
                                <ItemsControl x:Name="icRemedies">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Expander Header="{Binding Header}" Margin="0,2">
                                                <ItemsControl ItemsSource="{Binding Actions}" Margin="18,4,0,4">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Expander>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="재발 검증" Style="{StaticResource H1}"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="사후 스냅샷으로 검증..." Click="OnVerifyAfterSnapshot"/>
                                    <TextBlock Text="  또는 사용자 응답:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="관찰(분)" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBox x:Name="txtObservedMinutes" Width="50" Text="120" VerticalContentAlignment="Center"/>
                                    <Button Content="재발 없었어요" Click="OnVerifyNoRecur" Margin="8,0,0,0" Background="#DBF0DD"/>
                                    <Button Content="재발했어요" Click="OnVerifyRecurred"/>
                                </StackPanel>
                                <TextBlock x:Name="txtLastVerify" Style="{StaticResource Dim}" Margin="0,6,0,0"/>
                                <TextBlock x:Name="txtRestoreNote" Style="{StaticResource Dim}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ④ 수집기 로그 -->
            <TabItem Header="④ 수집기 로그">
                <TextBox x:Name="txtLog" IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         TextWrapping="NoWrap" Background="#101521" Foreground="#C9D4E8" Padding="8"/>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>

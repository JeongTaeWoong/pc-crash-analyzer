<Window x:Class="CrashAnalyzer.UI.SymptomDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="증상 선택" Width="430" SizeToContent="Height" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" FontSize="13" Background="{StaticResource Card}"
        FontFamily="Segoe UI Variable Text, Segoe UI, Malgun Gothic">
    <StackPanel Margin="16">
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,10"
                   Text="수동 마킹 덤프라 증상 정보가 없습니다. 세 가지만 알려 주세요 — 원본 덤프는 그대로 두고 채운 사본으로 진단합니다."/>
        <TextBlock Text="증상 종류" FontWeight="SemiBold"/>
        <ComboBox x:Name="cboType" Margin="0,4,0,10" SelectedIndex="0">
            <ComboBoxItem Tag="app_crash">프로그램 튕김 (강제 종료)</ComboBoxItem>
            <ComboBoxItem Tag="freeze">프리징 (멈춤)</ComboBoxItem>
            <ComboBoxItem Tag="fps_drop">프레임 저하·끊김</ComboBoxItem>
            <ComboBoxItem Tag="flicker">화면 깜빡임</ComboBoxItem>
            <ComboBoxItem Tag="input_loss">입력 누락·지연</ComboBoxItem>
            <ComboBoxItem Tag="launch_fail">실행 자체가 안 됨</ComboBoxItem>
            <ComboBoxItem Tag="network_fail">네트워크 오류</ComboBoxItem>
            <ComboBoxItem Tag="unexpected_reboot">갑작스런 재부팅</ComboBoxItem>
        </ComboBox>
        <TextBlock Text="증상 범위" FontWeight="SemiBold"/>
        <ComboBox x:Name="cboScope" Margin="0,4,0,10" SelectedIndex="0">
            <ComboBoxItem Tag="single_app">특정 프로그램 하나에서만</ComboBoxItem>
            <ComboBoxItem Tag="multiple_apps">여러 프로그램에서</ComboBoxItem>
            <ComboBoxItem Tag="system_wide">시스템 전체</ComboBoxItem>
            <ComboBoxItem Tag="unknown">모르겠음</ComboBoxItem>
        </ComboBox>
        <TextBlock Text="대상 프로그램 (예: game.exe — 없으면 비워 두세요)" FontWeight="SemiBold"/>
        <TextBox x:Name="txtTarget" Margin="0,4,0,14"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="진단 시작" Style="{StaticResource BtnPrimary}" Width="92" Margin="0,0,8,0" IsDefault="True" Click="OnOk"/>
            <Button Content="취소" Style="{StaticResource BtnSecondary}" Width="80" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>

<Window x:Class="CrashAnalyzer.UI.ChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="상담 도우미" Width="420" Height="560" MinWidth="360" MinHeight="420"
        WindowStartupLocation="Manual" ShowInTaskbar="False"
        Background="{StaticResource Card}"
        FontFamily="Segoe UI Variable Text, Segoe UI, Malgun Gothic" FontSize="13"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
    <!-- 2026-11-02 시안 2-4: 오른쪽 아래 버튼을 누르면 열리는 챗봇 창. 닫아도 숨기기만 해서 대화가 남는다. -->
    <DockPanel>
        <!-- 머리: 그림 + 제목 -->
        <StackPanel DockPanel.Dock="Top" Margin="18,14,18,0">
            <StackPanel Orientation="Horizontal">
                <Image x:Name="imgHead" Width="36" Height="36" Margin="0,0,8,0" Visibility="Collapsed"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock Text="상담 도우미" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextStrong}"
                           VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock x:Name="txtAgentMode" Style="{StaticResource Faint}" Margin="0,4,0,6"/>
        </StackPanel>

        <!-- 입력 줄 -->
        <DockPanel DockPanel.Dock="Bottom" Margin="16,0,16,14">
            <Button DockPanel.Dock="Right" Content="보내기" Style="{StaticResource BtnDark}" Margin="6,0,0,0"
                    Click="OnSend"/>
            <TextBox x:Name="txtInput" KeyDown="OnInputKeyDown" Padding="8,6"/>
        </DockPanel>

        <!-- 빠른 질문 -->
        <WrapPanel DockPanel.Dock="Bottom" Margin="16,6,16,8">
            <Button Content="왜 이게 원인이에요?" Style="{StaticResource BtnChip}" Margin="0,0,6,4" Click="OnQuick"/>
            <Button Content="다른 방법은 없어요?" Style="{StaticResource BtnChip}" Margin="0,0,6,4" Click="OnQuick"/>
            <Button Content="아직 그대로예요" Style="{StaticResource BtnChip}" Margin="0,0,6,4" Click="OnQuick"/>
        </WrapPanel>

        <!-- 대화 -->
        <ScrollViewer x:Name="svChat" VerticalScrollBarVisibility="Auto" Margin="4,0">
            <ItemsControl x:Name="icChat" Margin="10,4,10,8">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{Binding Bg}" CornerRadius="10" Padding="{Binding Pad}"
                                Margin="{Binding Outer}" HorizontalAlignment="{Binding Align}">
                            <TextBlock Text="{Binding Text}" Foreground="{Binding Fg}" FontSize="{Binding Size}"
                                       FontWeight="{Binding Weight}" TextWrapping="Wrap" LineHeight="19"/>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>

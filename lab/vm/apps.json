{
  "schema": 1,
  "note": "Programs that lab VMs can get (lab/vm/install.ps1). Decided 2026-11-12: paid programs are replaced by free or trial versions or by programs of the same kind. launch = how a case run starts the program (lab/vm/case.ps1): a path in the guest, 'skip' for programs without a window of their own, or nothing = found by its Start-menu shortcut; launch_sec = seconds to wait before looking at it (default in scenarios.json). kind = winget (installed inside the guest by winget, id checked with install.ps1 -Check), msi-url (downloaded on the host, sha256 must match), zip-exe (an installer inside a zip the user downloaded; the zip is found by file name in vm.json download_dirs), portable (a folder copied from the host). match = text that the installed program's name contains in the guest's list of installed programs; file = a path that must exist afterwards. Versions actually installed are recorded per clone in installed.json: a case must name the versions it was made with.",
  "apps": {
    "7zip":              { "name": "7-Zip",                 "kind": "winget", "id": "7zip.7zip",                         "match": "7-Zip" },
    "notepadpp":         { "name": "Notepad++",             "kind": "winget", "id": "Notepad++.Notepad++",               "match": "Notepad++" },
    "firefox":           { "name": "Firefox",               "kind": "winget", "id": "Mozilla.Firefox",                   "match": "Mozilla Firefox" },
    "chrome":            { "name": "Chrome",                "kind": "winget", "id": "Google.Chrome",                     "match": "Google Chrome" },
    "libreoffice":       { "name": "LibreOffice",           "kind": "winget", "id": "TheDocumentFoundation.LibreOffice", "match": "LibreOffice" },
    "vlc":               { "name": "VLC",                   "kind": "winget", "id": "VideoLAN.VLC",                      "match": "VLC media player" },
    "kakaotalk":         { "name": "KakaoTalk",             "kind": "winget", "id": "Kakao.KakaoTalk",                   "match": "KakaoTalk", "launch": "C:/Program Files/Kakao/KakaoTalk/KakaoTalk.exe", "note": "the display name is Korean on Korean Windows; found by the registry key name 'KakaoTalk'" },
    "krita":             { "name": "Krita",                 "kind": "winget", "id": "KDE.Krita",                         "match": "Krita",       "gpu": "recommended" },
    "gimp":              { "name": "GIMP",                  "kind": "winget", "id": "GIMP.GIMP",                         "match": "GIMP" },
    "inkscape":          { "name": "Inkscape",              "kind": "winget", "id": "Inkscape.Inkscape",                 "match": "Inkscape" },
    "blender":           { "name": "Blender",               "kind": "winget", "id": "BlenderFoundation.Blender",         "match": "Blender",     "gpu": "needed for the window" },
    "obs":               { "name": "OBS Studio",            "kind": "winget", "id": "OBSProject.OBSStudio",              "match": "OBS Studio",  "gpu": "recommended" },
    "vscode":            { "name": "Visual Studio Code",    "kind": "winget", "id": "Microsoft.VisualStudioCode",        "match": "Microsoft Visual Studio Code" },
    "git":               { "name": "Git",                   "kind": "winget", "id": "Git.Git",                           "match": "Git", "launch": "skip" },
    "godot":             { "name": "Godot",                 "kind": "winget", "id": "GodotEngine.GodotEngine",           "match": "",            "gpu": "needed for the editor", "note": "winget installs a portable exe: no entry in the list of installed programs, verified by winget list" },
    "autohotkey":        { "name": "AutoHotkey",            "kind": "winget", "id": "AutoHotkey.AutoHotkey",             "match": "AutoHotkey" },
    "logitech-ghub":     { "name": "Logitech G HUB",        "kind": "winget", "id": "Logitech.GHUB",                     "match": "Logitech G HUB", "note": "peripheral utility; runs resident services even without the device" },
    "artcraft-launcher": { "name": "ArtCraft Launcher",     "kind": "msi-url",
                           "url": "https://github.com/storytold/craft-launcher/releases/download/v0.19.0/artcraft-launcher-0.19.0-windows-x64.msi",
                           "sha256": "ffe30715f8d83c88f66c4938054b436f0603cc169115a6e3b63eaa073022655a",
                           "match": "ArtCraft", "note": "installs the launcher only; the Craft apps (PhotoCraft, PdfCraft, AniCraft, FigCraft ...) are then installed from inside it - not automated yet" },
    "davinci-resolve":   { "name": "DaVinci Resolve 21.2",  "kind": "zip-exe", "zip": "DaVinci_Resolve_21.2_Windows.zip", "inner": "DaVinci_Resolve_21.2_Windows.exe",
                           "args": "/i /q /noreboot", "match": "DaVinci Resolve", "gpu": "needed", "timeout_sec": 3600, "launch_sec": 90,
                           "note": "silent switches verified 2026-11-12 on clone video1: no window, 370 s, exit code 0, listed as 21.2.00006. It starts on video1 (integrated Radeon partition): window 'Welcome to DaVinci Resolve' within 90 s in the baseline run of 2026-11-12, alive with a window in two more runs that day. Opening a project or rendering is not verified" },

    "photocraft":        { "name": "PhotoCraft (image editor)",          "kind": "portable", "dir": "{artcraft}/PhotoCraft",     "exe": "photocraft.exe",     "gpu": "unknown" },
    "vectorcraft":       { "name": "VectorCraft (vector illustration)",  "kind": "portable", "dir": "{artcraft}/VectorCraft",    "exe": "vectorcraft.exe",    "gpu": "unknown" },
    "designcraft":       { "name": "DesignCraft (page layout)",          "kind": "portable", "dir": "{artcraft}/DesignCraft",    "exe": "designcraft.exe",    "gpu": "unknown" },
    "figcraft":          { "name": "FigCraft (interface design)",        "kind": "portable", "dir": "{artcraft}/FigCraft",       "exe": "figcraft.exe",       "gpu": "unknown" },
    "anicraft":          { "name": "AniCraft (2D animation)",            "kind": "portable", "dir": "{artcraft}/AniCraft",       "exe": "anicraft.exe",       "gpu": "unknown" },
    "lightcraft":        { "name": "LightCraft (photo library, raw)",    "kind": "portable", "dir": "{artcraft}/LightCraft",     "exe": "lightcraft.exe",     "gpu": "unknown" },
    "texturecraft":      { "name": "TextureCraft (3D texture painting)", "kind": "portable", "dir": "{artcraft}/TextureCraft",   "exe": "texturecraft.exe",   "gpu": "unknown" },
    "materialcraft":     { "name": "MaterialCraft (materials)",          "kind": "portable", "dir": "{artcraft}/MaterialCraft",  "exe": "materialcraft.exe",  "gpu": "unknown" },
    "filmcraft":         { "name": "FilmCraft (video editing)",          "kind": "portable", "dir": "{artcraft}/FilmCraft",      "exe": "filmcraft.exe",      "gpu": "unknown" },
    "effectcraft":       { "name": "EffectCraft (motion graphics)",      "kind": "portable", "dir": "{artcraft}/EffectCraft",    "exe": "effectcraft.exe",    "gpu": "unknown" },
    "soundcraft":        { "name": "SoundCraft (audio)",                 "kind": "portable", "dir": "{artcraft}/SoundCraft",     "exe": "soundcraft.exe" },
    "wordcraft":         { "name": "WordCraft (word processing)",        "kind": "portable", "dir": "{artcraft}/WordCraft",      "exe": "wordcraft.exe" },
    "deckcraft":         { "name": "DeckCraft (presentations)",          "kind": "portable", "dir": "{artcraft}/DeckCraft",      "exe": "deckcraft.exe" },
    "gridcraft":         { "name": "GridCraft (spreadsheets)",           "kind": "portable", "dir": "{artcraft}/GridCraft",      "exe": "gridcraft.exe" },
    "pdfcraft":          { "name": "PdfCraft (PDF)",                     "kind": "portable", "dir": "{artcraft}/PdfCraft",       "exe": "pdfcraft.exe" },
    "mailcraft":         { "name": "MailCraft (mail)",                   "kind": "portable", "dir": "{artcraft}/MailCraft",      "exe": "mailcraft.exe" },
    "cadcraft":          { "name": "CADCraft (CAD drafting)",            "kind": "portable", "dir": "{artcraft}/CADCraft",       "exe": "cadcraft.exe",       "gpu": "unknown" },
    "solidcraft":        { "name": "SolidCraft (solid modelling)",       "kind": "portable", "dir": "{artcraft}/SolidCraft",     "exe": "solidcraft.exe",     "gpu": "unknown" },
    "craft-anything":    { "name": "Craft Anything",                     "kind": "portable", "dir": "{artcraft}/Craft Anything", "exe": "craft-anything.exe" }
  },
  "artcraft_note": "The Craft apps (getartcraft.com/apps, free and open source, most of them early alpha or in development) were installed on the host by the user on 2026-11-12 with the ArtCraft launcher; vm.json artcraft_dir says where. Each app is a folder with a few executables, so a VM gets a copy of the folder at C:/lab/apps/<id> instead of going through the launcher. The copy has no Start-menu entry and no entry in the list of installed programs; the version is read from the executable.",
  "bundles": {
    "tools":      [ "7zip", "notepadpp" ],
    "office":     [ "7zip", "notepadpp", "chrome", "firefox", "libreoffice", "kakaotalk", "vlc", "wordcraft", "deckcraft", "gridcraft", "pdfcraft" ],
    "design":     [ "7zip", "krita", "gimp", "inkscape", "blender", "photocraft", "vectorcraft", "designcraft", "figcraft", "anicraft" ],
    "video":      [ "7zip", "vlc", "obs", "filmcraft", "effectcraft", "soundcraft", "davinci-resolve" ],
    "cad":        [ "7zip", "cadcraft", "solidcraft", "blender" ],
    "artcraft":   [ "photocraft", "vectorcraft", "designcraft", "figcraft", "anicraft", "lightcraft", "texturecraft", "materialcraft", "filmcraft", "effectcraft", "soundcraft", "wordcraft", "deckcraft", "gridcraft", "pdfcraft", "mailcraft", "cadcraft", "solidcraft", "craft-anything" ],
    "dev":        [ "7zip", "notepadpp", "git", "vscode", "godot", "autohotkey" ],
    "peripheral": [ "logitech-ghub" ]
  }
}

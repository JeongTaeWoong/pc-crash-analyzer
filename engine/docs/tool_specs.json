[
  {
    "description": "스냅샷 1건을 진단해 층 판정, 원인 후보 순위와 근거, 원인 확인 순서(점검 계획), 각 점검의 실행 방식(자동/확인/수동/안내)을 돌려준다. 상태를 저장하지 않는 1회성 분석.",
    "input_schema": {
      "properties": {
        "allowed_actions": {
          "description": "자동 모드에서 허용할 조치 id 목록 (비우면 규칙 기본값)",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "engine": {
          "default": "v1",
          "enum": [
            "v0",
            "v1"
          ],
          "type": "string"
        },
        "mode": {
          "default": "guide",
          "description": "guide=안내 모드, auto=자동 점검 모드",
          "enum": [
            "guide",
            "auto"
          ],
          "type": "string"
        },
        "rules_path": {
          "description": "규칙 파일 경로 (비우면 내장 기본 규칙)",
          "type": "string"
        },
        "snapshot": {
          "description": "스냅샷 JSON 객체 (snapshot_path 대신)",
          "type": "object"
        },
        "snapshot_path": {
          "description": "수집기가 덤프한 스냅샷 JSON 파일 경로",
          "type": "string"
        }
      },
      "type": "object"
    },
    "name": "diagnose"
  },
  {
    "description": "후보 하나(생략 시 1순위)의 근거를 기여도 순으로 문장 목록으로 돌려준다. LLM이 사용자에게 '왜 이것이 원인인지' 설명할 때 쓴다.",
    "input_schema": {
      "properties": {
        "candidate_id": {
          "description": "예: anticheat:vgk.sys",
          "type": "string"
        },
        "rules_path": {
          "type": "string"
        },
        "snapshot": {
          "type": "object"
        },
        "snapshot_path": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "name": "explain"
  },
  {
    "description": "진단 세션을 시작한다(증상 → 원인 확인 → 해결 안내 → 검증). 세션 상태는 session_path 파일에 저장되고, 첫 점검(next_check)을 돌려준다.",
    "input_schema": {
      "properties": {
        "allowed_actions": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "engine": {
          "default": "v1",
          "enum": [
            "v0",
            "v1"
          ],
          "type": "string"
        },
        "mode": {
          "default": "guide",
          "enum": [
            "guide",
            "auto"
          ],
          "type": "string"
        },
        "rules_path": {
          "type": "string"
        },
        "session_path": {
          "description": "세션 상태를 저장할 JSON 파일 경로",
          "type": "string"
        },
        "snapshot": {
          "type": "object"
        },
        "snapshot_path": {
          "type": "string"
        }
      },
      "required": [
        "session_path"
      ],
      "type": "object"
    },
    "name": "session_start"
  },
  {
    "description": "세션의 현재 상태, 후보 확률, 다음 점검 또는 해결 안내를 돌려준다.",
    "input_schema": {
      "properties": {
        "session_path": {
          "type": "string"
        }
      },
      "required": [
        "session_path"
      ],
      "type": "object"
    },
    "name": "session_status"
  },
  {
    "description": "안내한 점검의 결과를 알린다. solved=증상이 사라짐, not_solved=그대로, skipped=수행할 수 없음. 엔진이 후보 확률을 베이즈 갱신하고 다음 점검 또는 확인된 원인을 돌려준다.",
    "input_schema": {
      "properties": {
        "check_id": {
          "description": "next_check.check_id",
          "type": "string"
        },
        "result": {
          "enum": [
            "solved",
            "not_solved",
            "skipped"
          ],
          "type": "string"
        },
        "session_path": {
          "type": "string"
        }
      },
      "required": [
        "session_path",
        "check_id",
        "result"
      ],
      "type": "object"
    },
    "name": "session_report"
  },
  {
    "description": "원인이 확인된 뒤 해결책을 적용했음을 기록한다. remedy_id 를 생략하면 현재 추천 해결책으로 본다.",
    "input_schema": {
      "properties": {
        "applied_at": {
          "description": "적용 시각 ISO-8601 (생략 시 지금)",
          "type": "string"
        },
        "remedy_id": {
          "type": "string"
        },
        "session_path": {
          "type": "string"
        }
      },
      "required": [
        "session_path"
      ],
      "type": "object"
    },
    "name": "session_apply_fix"
  },
  {
    "description": "해결책 적용 후 재발 여부를 검증한다. 사후 스냅샷(after_snapshot_path/after_snapshot)을 주거나, 로그로 셀 수 없는 증상이면 recurred 와 observed_minutes 를 준다. 해결되면 사례 DB에 반영한다.",
    "input_schema": {
      "properties": {
        "after_snapshot": {
          "type": "object"
        },
        "after_snapshot_path": {
          "type": "string"
        },
        "observed_minutes": {
          "type": "number"
        },
        "recurred": {
          "type": "boolean"
        },
        "save_rules": {
          "default": false,
          "description": "true면 세션의 rules_path 파일에 사례 DB 갱신을 저장",
          "type": "boolean"
        },
        "session_path": {
          "type": "string"
        }
      },
      "required": [
        "session_path"
      ],
      "type": "object"
    },
    "name": "session_verify"
  }
]